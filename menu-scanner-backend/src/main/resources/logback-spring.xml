<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Register Spring Boot's %clr color converter and other extensions -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName"    source="spring.application.name" defaultValue="emenu"/>
    <springProperty scope="context" name="appVersion" source="app.version"             defaultValue="1.0.0"/>

    <!-- ─── Console — clean, colored, single-line per log entry ─────────────── -->
    <!--
        Format:  HH:mm:ss.SSS  LEVEL  ShortLogger(35)  [traceId]  message
        traceId  — set by RequestIdFilter for every HTTP request
        Colors:  timestamp=faint  ERROR=bold-red  WARN=yellow  INFO=green  DEBUG=cyan
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%clr(%d{HH:mm:ss.SSS}){faint} %clr(%-5level){highlight} %clr(%-35.35logger{35}){cyan} %clr([%X{traceId:--}]){blue} %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ─── Rolling file — plain text, all profiles ──────────────────────────── -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/application.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %-35.35logger{35} [%X{traceId:--}] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ─── Error-only file — 90-day retention ───────────────────────────────── -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/error.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>90</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} ERROR %-35.35logger{35} [%X{traceId:--}] %msg%n%ex{full}</pattern>
        </encoder>
    </appender>

    <!-- ─── Root + app levels (same across all profiles) ────────────────────── -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

    <logger name="com.emenu" level="INFO"/>

    <!-- Controllers: "Endpoint: ..." INFO lines are redundant — access log covers it -->
    <logger name="com.emenu.features.auth.controller"         level="WARN"/>
    <logger name="com.emenu.features.main.controller"         level="WARN"/>
    <logger name="com.emenu.features.order.controller"        level="WARN"/>
    <logger name="com.emenu.features.hr.controller"           level="WARN"/>
    <logger name="com.emenu.features.portfolio.controller"    level="WARN"/>
    <logger name="com.emenu.features.subscription.controller" level="WARN"/>
    <logger name="com.emenu.features.spaces.controller"       level="WARN"/>
    <!-- Audit service: request summary already in RequestIdFilter access log -->
    <logger name="com.emenu.features.audit"                   level="WARN"/>

    <!-- ─── Framework noise suppression ─────────────────────────────────────── -->
    <logger name="org.springframework"                       level="WARN"/>
    <logger name="org.hibernate"                             level="WARN"/>
    <logger name="org.apache.catalina"                       level="WARN"/>
    <logger name="org.apache.tomcat"                         level="WARN"/>
    <logger name="com.github.benmanes.caffeine"              level="WARN"/>
    <logger name="io.lettuce.core"                           level="WARN"/>
</configuration>
