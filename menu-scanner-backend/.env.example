# =============================================================================
# .env.example — Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=e_menu_platform
DB_USERNAME=postgres
DB_PASSWORD=change_me

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_DATABASE=0

# ── JWT (min 64 chars — generate with: openssl rand -hex 64) ─────────────────
JWT_SECRET=replace_with_64_char_random_string_generated_by_openssl_rand_hex_64_xxxxxxxxxx
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash, no wildcard)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ── Cache provider ────────────────────────────────────────────────────────────
# "caffeine" (local, single-node) or "redis" (distributed, multi-node)
CACHE_PROVIDER=redis

# ── Admin bootstrap ───────────────────────────────────────────────────────────
APP_ADMIN_EMAIL=admin@yourdomain.com
APP_ADMIN_PASSWORD=change_me_strong_password

# ── Telegram (optional) ───────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=

# ── Google OAuth2 (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
